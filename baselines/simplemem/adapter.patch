+EMBEDDING_DIMENSION = 1024
+EMBEDDING_CONTEXT_LENGTH = 32768
+EMBEDDING_QUERY_PROMPT = True
+
+WINDOW_SIZE = 20
+OVERLAP_SIZE = 15  # 20-turn window - 15-turn overlap = stride 5
