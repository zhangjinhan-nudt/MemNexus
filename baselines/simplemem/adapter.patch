+from types import SimpleNamespace
+
+import pytest
+
+from simplemem.core.utils.llm_client import LLMClient
+
+
+def test_non_streaming_usage_is_recorded(monkeypatch):
+    monkeypatch.setenv("EXPERIMENT_COMPONENT_BUDGET_RMB", "1")
+    client = LLMClient(
+        api_key="test-key",
+        model="deepseek-v4-flash",
+        base_url="https://example.invalid",
+        use_streaming=False,
+    )
+    response = SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content="OK"))],
+        usage=SimpleNamespace(prompt_tokens=10, completion_tokens=2),
+    )
+    client.client = SimpleNamespace(
+        chat=SimpleNamespace(completions=SimpleNamespace(create=lambda **kwargs: response))
+    )
+
+    assert client.chat_completion([{"role": "user", "content": "probe"}]) == "OK"
+    assert client.usage["provider_attempts"] == 1
+    assert client.usage["input_tokens"] == 10
+    assert client.usage["output_tokens"] == 2
+    assert client.usage["cost_rmb"] > 0
+
+
+def test_deepseek_thinking_is_explicitly_disabled(monkeypatch):
+    monkeypatch.setenv("EXPERIMENT_COMPONENT_BUDGET_RMB", "1")
+    client = LLMClient(
+        api_key="test-key",
+        model="deepseek-v4-flash",
+        base_url="https://api.deepseek.com",
+        use_streaming=False,
+    )
+    captured = {}
+    response = SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content="OK"))],
+        usage=SimpleNamespace(prompt_tokens=1, completion_tokens=1),
+    )
+
+    def create(**kwargs):
+        captured.update(kwargs)
+        return response
+
+    client.client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)))
+    client.chat_completion([{"role": "user", "content": "probe"}])
+    assert captured["extra_body"] == {"thinking": {"type": "disabled"}}
+
+
+def test_truncated_array_is_not_silently_reduced_to_first_object():
+    client = LLMClient.__new__(LLMClient)
+    with pytest.raises(ValueError, match="top-level JSON array"):
+        client.extract_json('```json\n[{"lossless_restatement":"partial"}')
+
+
+@pytest.mark.parametrize("second_reason", ["stop", "length"])
+def test_one_length_recovery_is_counted_and_bounded(monkeypatch, second_reason):
+    from simplemem.core.utils.llm_client import TruncatedOutputError
+
+    monkeypatch.setenv("EXPERIMENT_TRUNCATION_MAX_TOKENS", "8192")
+    monkeypatch.setenv("EXPERIMENT_COMPONENT_BUDGET_RMB", "1")
+    client = LLMClient(api_key="test", model="test", base_url="https://example.invalid", use_streaming=False)
+    limits = []
+
+    def create(**kwargs):
+        limits.append(kwargs["max_tokens"])
+        return SimpleNamespace(
+            choices=[SimpleNamespace(message=SimpleNamespace(content="valid"),
+                                     finish_reason="length" if len(limits) == 1 else second_reason)],
+            usage=SimpleNamespace(prompt_tokens=10, completion_tokens=5),
+        )
+
+    client.client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)))
+    if second_reason == "length":
+        with pytest.raises(TruncatedOutputError):
+            client.chat_completion([{"role": "user", "content": "test"}])
+    else:
+        assert client.chat_completion([{"role": "user", "content": "test"}]) == "valid"
+    assert limits == [4096, 8192]
+    assert client.usage["provider_attempts"] == 2
+    assert client.usage["length_recovery_attempts"] == 1
+    assert client.usage["input_tokens"] == 20
+    assert client.usage["output_tokens"] == 10
+    assert client.usage["reserved_rmb"] == 0
