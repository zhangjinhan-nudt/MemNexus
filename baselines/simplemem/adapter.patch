+    """Stop the experiment; retrieval fallbacks must not swallow audit failures."""
+
+
+class BudgetExceededError(BaseException):
+    """A provider request cannot fit inside this experiment component's cap."""
+
+
+class TruncatedOutputError(BaseException):
