+KEYWORD_TOP_K = 5
+STRUCTURED_TOP_K = 5
+
+LANCEDB_PATH = "./lancedb_data"
+MEMORY_TABLE_NAME = "memory_entries"
+ENABLE_PARALLEL_PROCESSING = False
+MAX_PARALLEL_WORKERS = 1
+ENABLE_PARALLEL_RETRIEVAL = False
+MAX_RETRIEVAL_WORKERS = 1
+ENABLE_PLANNING = True
+ENABLE_REFLECTION = True
+MAX_REFLECTION_ROUNDS = 2
+
+JUDGE_API_KEY = ""
+JUDGE_BASE_URL = "https://api.deepseek.com"
+JUDGE_MODEL = "deepseek-v4-flash"
+JUDGE_ENABLE_THINKING = False
+JUDGE_USE_STREAMING = False
+JUDGE_TEMPERATURE = 0.0
+
+# Combined ceiling across both systems and judging. The unified runner is the
+# authority for enforcing it; prices must be set to current provider values.
+EXPERIMENT_BUDGET_RMB = 8.0
+INPUT_PRICE_RMB_PER_MILLION_TOKENS = 2.4
+OUTPUT_PRICE_RMB_PER_MILLION_TOKENS = 9.6
