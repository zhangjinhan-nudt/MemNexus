+import numpy as np
+
+from simplemem.core.utils.embedding import EmbeddingModel
+
+
+class FakeQwen:
+    prompts = {"query": "query:"}
+
+    def __init__(self):
+        self.calls = []
+
+    def encode(self, texts, **kwargs):
+        self.calls.append(kwargs)
+        return np.asarray([[1.0, 0.0] for _ in texts])
+
+
+def test_qwen_query_uses_prompt_and_documents_do_not():
+    embedding = EmbeddingModel.__new__(EmbeddingModel)
+    embedding.model = FakeQwen()
+    embedding.model_type = "qwen3_sentence_transformer"
+    embedding.supports_query_prompt = True
+
+    embedding.encode_query(["question"])
+    embedding.encode_documents(["memory"])
+
+    assert embedding.model.calls[0]["prompt_name"] == "query"
+    assert "prompt_name" not in embedding.model.calls[1]
+
+
+def test_qwen_query_prompt_mismatch_fails_closed():
+    embedding = EmbeddingModel.__new__(EmbeddingModel)
+    embedding.model = FakeQwen()
+    embedding.model_type = "qwen3_sentence_transformer"
+    embedding.supports_query_prompt = False
+
+    try:
+        embedding.encode_query(["question"])
+    except RuntimeError as error:
+        assert "query prompt" in str(error)
+    else:
+        raise AssertionError("query encoding silently fell back to document encoding")
