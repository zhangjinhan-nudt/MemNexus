# Copy this file to .env for local development. Process environment values win.
MEMORY_DB_PATH=data/memory.sqlite3
MEMORY_LOCAL_TENANT=local
MEMORY_LOCAL_OWNER=demo
MEMORY_DEPLOYMENT_MODE=local
# Production requires at least 32 characters; never put this key in a VITE_* variable.
MEMORY_API_KEY=
# Local mode has one fixed principal and should bind to 127.0.0.1 only.
MEMORY_ALLOWED_ORIGINS=
# Optional model; missing configuration raises 503 for extraction/answering.
MEMORY_MODEL_BASE_URL=
MEMORY_MODEL_NAME=deepseek-v4-flash
MEMORY_MODEL_API_KEY=
MEMORY_MODEL_TIMEOUT=180
MEMORY_MODEL_MAX_TOKENS=4096
# Main-model and judge budget guard. Values are RMB; the runner stops before
# an invocation that would exceed the configured ceiling.
MEMORY_BUDGET_RMB=8
MEMORY_JUDGE_MODEL_NAME=deepseek-v4-flash
MEMORY_JUDGE_API_KEY=
MEMORY_JUDGE_BASE_URL=https://api.deepseek.com
# Fill in current provider prices before a paid run. Zero disables paid runs
# because the runner cannot prove that the hard ceiling will be respected.
MEMORY_INPUT_PRICE_RMB_PER_MILLION_TOKENS=2.4
MEMORY_OUTPUT_PRICE_RMB_PER_MILLION_TOKENS=9.6
# Keep model for the paper baseline; adaptive skips planning only for unique exact-field lookups.
MEMORY_PLANNER_MODE=model
# Typed collection queries and auditable answer composition; false is an answer-path ablation.
MEMORY_COLLECTION_QUERIES=true
# Formal English benchmark mode for LoCoMo/LongMemEval and ICAPS reports.
MEMORY_OUTPUT_LANGUAGE=en
MEMORY_CONTEXT_TURNS=15
# Experimental semantic execution path. It uses one initial binding call and
# at most one bounded reread/retrieval update per answer.
MEMORY_SEMANTIC_EXECUTION=false
MEMORY_SEMANTIC_COMPLEX_ONLY=true
MEMORY_PREMISE_RETRIEVAL=true
MEMORY_REREAD_ENABLED=true
MEMORY_OPEN_DOMAIN_COMPAT=true
MEMORY_SEMANTIC_MAX_ANSWER_CALLS=2
# Join original source dates/speakers; one bounded raw-source supplement.
MEMORY_GROUNDING_ENABLED=true
MEMORY_GROUNDING_RAW_LIMIT=3
# Raw BM25+Qwen RRF is an ablation only; it did not improve the 44-query check.
MEMORY_GROUNDING_SEMANTIC=false
# Reuse only identical authorized context after fresh retrieval; no semantic answer cache.
MEMORY_ACCELERATION_ENABLED=true
MEMORY_INFERENCE_CACHE_TTL=60
MEMORY_INFERENCE_CACHE_ENTRIES=128
# Periodic extraction/maintenance for the configured local principal; 0 disables the worker.
MEMORY_MAINTENANCE_INTERVAL=300
# Bump when an embedding provider changes weights behind an unchanged model name.
MEMORY_EMBEDDING_REVISION=1
# Formal comparison: queries use Qwen3's query prompt, while documents use
# ordinary normalized encoding. The bundled local server supports input_type.
MEMORY_EMBEDDING_ENCODING=query_prompt
# Optional independent embedding service; leave all empty for explicit lexical baseline.
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8099/v1
MEMORY_EMBEDDING_NAME=Qwen/Qwen3-Embedding-0.6B
MEMORY_EMBEDDING_API_KEY=
# DeepSeek example (keep the key in the private .env only):
# MEMORY_MODEL_BASE_URL=https://api.deepseek.com
# MEMORY_MODEL_NAME=deepseek-flash
# GLM example:
# MEMORY_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MEMORY_MODEL_NAME=glm-5.3
